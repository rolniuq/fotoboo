# Core app
PORT=8080
APP_BIND_ADDRESS=127.0.0.1
WEB_DIR=/app/web
DB_PATH=/app/data/fotoboo.db
STORAGE_PATH=/app/data/photos
BASE_URL=http://localhost:8080

# HTTPS reverse proxy (prod profile)
DOMAIN=localhost
LETSENCRYPT_EMAIL=ops@example.com

# Storage backend
USE_MINIO=false
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fotoboo
MINIO_USE_SSL=false

# Optional MinIO host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
